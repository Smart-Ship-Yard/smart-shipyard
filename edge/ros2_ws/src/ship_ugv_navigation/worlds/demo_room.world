<?xml version="1.0"?>
<!-- 자동 생성됨: scripts/make_demo_world.py — 직접 편집하지 말 것 -->
<!-- 방 내부 3.5 x 3.4 m, 중앙에 모형배 0.4 x 0.5 m -->
<sdf version="1.6">
  <world name="demo_room">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- 실시간 배속 1.0 기준. 물리가 불안정하면 max_step_size를 줄일 것 -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- 벽: static이라 물리 연산 대상이 아니고 충돌체로만 동작 -->
    <model name="room_walls">
      <static>true</static>
      <link name="wall_north">
        <pose>0.0000 1.7250 0.2500 0 0 0</pose>
        <collision name="wall_north_collision">
          <geometry><box><size>3.6000 0.0500 0.5000</size></box></geometry>
        </collision>
        <visual name="wall_north_visual">
          <geometry><box><size>3.6000 0.0500 0.5000</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_south">
        <pose>0.0000 -1.7250 0.2500 0 0 0</pose>
        <collision name="wall_south_collision">
          <geometry><box><size>3.6000 0.0500 0.5000</size></box></geometry>
        </collision>
        <visual name="wall_south_visual">
          <geometry><box><size>3.6000 0.0500 0.5000</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_east">
        <pose>1.7750 0.0000 0.2500 0 0 0</pose>
        <collision name="wall_east_collision">
          <geometry><box><size>0.0500 3.5000 0.5000</size></box></geometry>
        </collision>
        <visual name="wall_east_visual">
          <geometry><box><size>0.0500 3.5000 0.5000</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_west">
        <pose>-1.7750 0.0000 0.2500 0 0 0</pose>
        <collision name="wall_west_collision">
          <geometry><box><size>0.0500 3.5000 0.5000</size></box></geometry>
        </collision>
        <visual name="wall_west_visual">
          <geometry><box><size>0.0500 3.5000 0.5000</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 모형배(레고). 실물에서는 이 자리에 배가 놓이고 로봇이 주위를 돈다.
         라이다 높이(0.2m)보다 높아야 스캔에 잡힌다. -->
    <model name="ship_block">
      <static>true</static>
      <link name="ship_link">
        <pose>0.0000 0.0000 0.1250 0 0 0</pose>
        <collision name="ship_collision">
          <geometry><box><size>0.4000 0.5000 0.2500</size></box></geometry>
        </collision>
        <visual name="ship_visual">
          <geometry><box><size>0.4000 0.5000 0.2500</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.9 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <gui>
      <camera name="user_camera">
        <pose>0 -4.5 4.0 0 0.75 1.5708</pose>
      </camera>
    </gui>

  </world>
</sdf>
