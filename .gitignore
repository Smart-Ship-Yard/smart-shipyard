# 파이썬 캐시 파일 무시 (프로그램 속도 향상용 파일들)
__pycache__/
*.pyc
*.pyo
# 가상환경 폴더 무시 (용량이 너무 크고 컴퓨터마다 환경이 다르니까!)
venv/
.venv/
# 비밀번호가 담긴 금고 파일 무시
.env
# VS Code 설정 파일들 (개인 환경 설정이라 굳이 공유 안 함)
.vscode/
# colcon (ROS 2) 빌드 산출물
build/
install/
log/
# ROS 2 view_frames(tf2_tools)가 실행할 때마다 생성하는 TF 트리 디버그 파일
frames_*.gv
frames_*.pdf
# Node.js 의존성 폴더 (npm install로 각자 재생성)
node_modules/
# Orbbec SDK 런타임 로그 (실행 위치에 자동 생성됨)
Log/
OrbbecSDK.log*
edge/ros2_ws/src/ship_ugv_perception/weights/*.pt
# 프론트엔드(Vite) 빌드 산출물 — npm run build가 만드는 배포용 파일
dist/
dist-ssr/
*.local
# 각종 로그 파일 (npm/yarn 등이 에러 시 자동 생성)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
# 에디터·개인 도구 설정 (개인 환경이라 공유 안 함)
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Claude Code 등 AI 도구의 개인 로컬 설정
.claude/
graphify-out/cache/
graphify-out/cost.json
graphify-out/manifest.json
# graphify 가 재추출할 때마다 만드는 날짜별 백업 (1 MB씩 쌓인다)
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
# 질의용 사이드카 — graph.json 에서 다시 만들 수 있다
graphify-out/.graphify_analysis.json

# 모델 백업 (21MB 바이너리). 되돌릴 때만 쓰고 레포에는 안 올린다.
edge/ros2_ws/src/ship_ugv_perception/weights/*.bak-*

# 이벤트 스냅샷 — 위험 이벤트가 감지된 순간의 사진 (2026-08-27)
#   ★ 절대 올리지 않는다. 용량 때문이 아니라 **사생활** 때문이다.
#   현장 카메라가 찍은 것이라 작업자 얼굴이 그대로 들어간다. 한 번 올라가면
#   나중에 지워도 git 이력에 남으므로, 처음부터 막는다.
#   (용량도 이유이긴 하다 — 이벤트당 약 9 KB 가 계속 쌓인다)
#   실제 파일은 백엔드를 돌리는 컴퓨터에만 두고, DB 에는 경로만 남긴다.
#   폴더 자체는 남긴다(.gitkeep) — 없으면 새로 clone 했을 때
#   StaticFiles(directory="snapshots") 가 폴더를 못 찾아 서버가 죽는다.
backend/snapshots/*
!backend/snapshots/.gitkeep

# graphify install 이 "CLAUDE.md 가 없는 폴더"에서 실행되면 거기에 9줄짜리 안내
# 파일을 자동 생성한다 (예: backend/CLAUDE.md). 루트 CLAUDE.md 의 graphify 절과
# 내용이 같아 중복이므로 커밋하지 않는다. 루트 것은 팀 공유 파일이라 유지한다.
CLAUDE.md
!/CLAUDE.md

# mediamtx 가 MoQ용으로 자동 생성하는 자체 서명 인증서.
# 실행한 폴더에 만들어지는데, systemd 유닛은 WorkingDirectory 를 ~/mediamtx 로
# 잡아두어 여기 생기지 않는다. 수동 실행 시 대비해 막아둔다.
auto.crt
auto.key
