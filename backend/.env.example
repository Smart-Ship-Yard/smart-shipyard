# 주의: 몽고DB 비밀번호는 백엔드 담당자에게 물어볼 것!
MONGO_URL="mongodb+srv://shipyard_admin:<여기에_비밀번호_입력>@smartshipyard.ftatnfq.mongodb.net/shipyard_db?appName=SmartShipyard"


# 대시보드 접근 암호.
#
#   값을 넣으면      → 대시보드에 로그인 화면이 뜨고, 조회 API 도 잠긴다
#   비워두거나 없으면 → 인증을 아예 안 한다 (누구나 들어옴)
#
#   비워둔 상태를 기본으로 두는 이유는, 팀원이 각자 노트북에서 받아 그대로
#   실행할 수 있어야 하기 때문이다. 값을 넣는 순간 켜진다.
#
#   ⚠️ 현장 적용 전에는 반드시 넣을 것. 안 넣으면 같은 망의 누구나 관제 화면을 본다.
DASHBOARD_PASSWORD=
